{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Launch ruml",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceFolder}/target/debug/ruml.exe",
            "preLaunchTask": "cargo build",
            "args": [
                "${input:INPUT}",
                "${input:FILENAME}"
            ],
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "INPUT",
            "description": "Directory of the project to run ruml on",
            "default": "${workspaceFolder}"
        },
        {
            "type": "promptString",
            "id": "FILENAME",
            "description": "Filename of output file created by ruml (.puml)",
            "default": "plantuml.puml"
        }
    ]
}